<!--
    Example Organization Custom Styles Template
    
    PURPOSE:
    This template demonstrates how to create organization-specific templates that extend
    base templates with custom colors, branding, and styling.
    
    USAGE:
    1. Copy this template as a starting point for your organization
    2. Customize colors to match your brand guidelines
    3. Add organization-specific elements
    4. Maintain compatibility with base template structure
    
    CUSTOMIZATION NOTES:
    - This example uses custom orange color scheme (#FF6B35)
    - Base template uses standard AWS colors
    - Only colors and styling are customized - structure remains the same
    - Icon shapes and sizes remain standard
    
    INHERITANCE:
    This template inherits from templates/base/aws-vpc-template.drawio
    - Structure: Same container hierarchy
    - Layout: Same spacing and positioning
    - Icons: Same icon shapes (don't change)
    - Colors: Customized for organization branding
-->
<mxfile host="app.diagrams.net" modified="2025-01-27T00:00:00.000Z" agent="draw.io" version="22.1.16" etag="example-org-template" type="device">
    <diagram id="example-org-vpc" name="Example Org VPC Template">
        <mxGraphModel dx="1422" dy="794" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2339" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                
                <!--
                    TITLE WITH ORGANIZATION BRANDING
                    Customize title to include organization name
                -->
                <mxCell id="title" 
                        value="Example Organization - AWS VPC Architecture" 
                        style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#FF6B35;" 
                        parent="1" 
                        vertex="1">
                    <mxGeometry x="900" y="20" width="800" height="40" as="geometry" />
                </mxCell>

                <!--
                    AWS CLOUD CONTAINER
                    Same structure as base template
                    Only border color customized for organization
                -->
                <mxCell id="internet" 
                        value="AWS Cloud" 
                        style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#FF6B35;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" 
                        parent="1" 
                        vertex="1">
                    <!--
                        CUSTOMIZATION: strokeColor changed from #232F3E to #FF6B35
                        This matches organization brand color
                    -->
                    <mxGeometry x="40" y="100" width="3200" height="2200" as="geometry" />
                </mxCell>

                <!--
                    VPC CONTAINER
                    Same structure as base template
                    Border color customized to match organization theme
                -->
                <mxCell id="vpc" 
                        value="VPC (10.0.0.0/16)" 
                        style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#FF6B35;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" 
                        parent="internet" 
                        vertex="1">
                    <!--
                        CUSTOMIZATION: strokeColor changed from #248814 (green) to #FF6B35 (orange)
                        Maintains VPC structure but uses organization color
                    -->
                    <mxGeometry x="400" y="150" width="2800" height="2100" as="geometry" />
                </mxCell>

                <!--
                    EXAMPLE SERVICE WITH CUSTOM COLOR
                    Lambda function using organization color scheme
                -->
                <mxCell id="lambda-example" 
                        value="Lambda Function" 
                        style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FF6B35;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.lambda;" 
                        parent="vpc" 
                        vertex="1">
                    <!--
                        CUSTOMIZATION: fillColor changed from #759C3E (green) to #FF6B35 (orange)
                        This applies organization brand color to compute services
                        Icon shape remains the same (mxgraph.aws4.lambda)
                    -->
                    <mxGeometry x="100" y="100" width="78" height="78" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    NOTES FOR CUSTOMIZATION
                    ========================================================================
                    
                    COLOR CUSTOMIZATION:
                    - Base template uses: #759C3E (green) for compute services
                    - Organization uses: #FF6B35 (orange) for compute services
                    - Change fillColor in style attribute
                    - Keep icon shape names unchanged (mxgraph.aws4.*)
                    
                    STRUCTURE CUSTOMIZATION:
                    - Keep container hierarchy the same
                    - Keep icon sizes the same (78x78)
                    - Keep spacing the same (150px)
                    - Only customize colors and branding
                    
                    BRANDING ELEMENTS:
                    - Title includes organization name
                    - Border colors match brand
                    - Service icons use brand colors
                    - Maintain readability and contrast
                    
                    COMPATIBILITY:
                    - Template remains compatible with base structure
                    - AI agents can use either template
                    - Organization-specific elements are optional
                    - Base structure ensures compatibility
                -->
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>

