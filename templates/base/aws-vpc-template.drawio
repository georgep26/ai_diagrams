<!--
    AWS VPC Base Template for draw.io
    
    PURPOSE:
    This template provides a foundational structure for AWS VPC diagrams with extensive
    XML comments to help AI agents understand how to generate proper draw.io architecture diagrams.
    
    USAGE:
    1. Copy this template structure when creating AWS VPC diagrams
    2. Modify the geometry values to position components
    3. Add or remove services as needed
    4. Maintain the parent-child hierarchy for proper nesting
    
    KEY CONCEPTS:
    - Container hierarchy: Internet → VPC → Subnets → Services
    - Geometry: x, y coordinates + width, height define position and size
    - Parent-child relationships: Components must be children of their container
    - Style attributes: Control appearance, colors, icons, and behavior
    
                    ICON LOADING:
                    Ensure AWS icons are loaded in draw.io:
                    - Recommended: Load from m-radzikowski/diagrams-aws-icons repository
                      File → Open Library from → URL → https://raw.githubusercontent.com/m-radzikowski/diagrams-aws-icons/master/20240206/AWS%20Architecture%20Icons%2020240206.xml
                    - Alternative: Open draw.io with: https://app.diagrams.net/?splash=0&libs=aws4
                    - Or: More Shapes → Networking → AWS → Apply
                    
                    IMPORTANT: All icon shape names in this template use lowercase (e.g., lambda, not Lambda)
                    This matches the m-radzikowski/diagrams-aws-icons repository format.
                    
                    For complete icon reference, see: guides/ICON_REFERENCE.md
-->
<mxfile host="app.diagrams.net" modified="2025-01-27T00:00:00.000Z" agent="draw.io" version="22.1.16" etag="vpc-template" type="device">
    <diagram id="aws-vpc-template" name="AWS VPC Template">
        <!--
            mxGraphModel: Root element for the diagram model
            dx/dy: Canvas size (horizontal/vertical space)
            grid: Enable grid (1) or disable (0) - default is 0 (no grid)
            gridSize: Grid spacing in pixels (10 = standard)
            guides: Show alignment guides (1) or hide (0)
            tooltips: Enable tooltips (1) or disable (0)
            connect: Allow connections (1) or disable (0)
            arrows: Show connection arrows (1) or hide (0)
            fold: Allow folding/collapsing (1) or disable (0)
            page: Page number (1)
            pageScale: Zoom level (1 = 100%)
            pageWidth/pageHeight: Canvas dimensions in pixels
            background: Background color (#ffffff = white) - default is white
        -->
        <mxGraphModel dx="1422" dy="794" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2339" background="#ffffff" math="0" shadow="0">
            <root>
                <!--
                    mxCell id="0": Root cell - required, never modify
                    This is the absolute root of the diagram hierarchy
                -->
                <mxCell id="0" />
                
                <!--
                    mxCell id="1": Default parent cell for top-level elements
                    Most elements will have parent="1" or parent="[container-id]"
                    This is the working layer of the diagram
                -->
                <mxCell id="1" parent="0" />
                
                <!--
                    ========================================================================
                    TITLE SECTION
                    ========================================================================
                    Title text displayed at the top of the diagram
                -->
                
                <!--
                    Title Cell
                    - value: Text displayed in the title
                    - style: Text styling (no border, no fill, centered, large font)
                    - parent="1": Top-level element
                    - vertex="1": This is a shape (not a connection)
                    - Geometry: x/y position, width/height size
                -->
                <mxCell id="title" 
                        value="AWS VPC Architecture Template" 
                        style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" 
                        parent="1" 
                        vertex="1">
                    <!--
                        Geometry for Title:
                        x="1050": Horizontal position (centered on 3300px canvas)
                        y="20": Vertical position (near top)
                        width="600": Text width
                        height="40": Text height
                    -->
                    <mxGeometry x="1050" y="20" width="600" height="40" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    INTERNET / AWS CLOUD CONTAINER
                    ========================================================================
                    This is the outermost container representing the AWS Cloud boundary.
                    All AWS resources should be placed inside this container.
                -->
                
                <!--
                    Internet/AWS Cloud Container
                    - shape=mxgraph.aws4.group: This is a group/container shape
                    - grIcon=mxgraph.aws4.group_aws_cloud: AWS cloud icon for the container
                    - container=1: This is a container (can hold child elements)
                    - pointerEvents=0: Children can be clicked, not the container border
                    - collapsible=0: Cannot collapse this container
                    - recursiveResize=0: Resizing doesn't affect children automatically
                    - strokeColor=#232F3E: Dark gray border (AWS standard)
                    - fillColor=none: Transparent background
                    - verticalAlign=top: Content starts at top
                    - spacingLeft=30: Left padding for content
                -->
                <mxCell id="internet" 
                        value="AWS Cloud" 
                        style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" 
                        parent="1" 
                        vertex="1">
                    <!--
                        Geometry for Internet Container:
                        x="40": Start 40px from left edge
                        y="100": Start 100px from top (below title)
                        width="3200": Full width minus margins
                        height="2200": Full height minus margins
                        This creates a large container for all AWS resources
                    -->
                    <mxGeometry x="40" y="100" width="3200" height="2200" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    VPC CONTAINER
                    ========================================================================
                    VPC (Virtual Private Cloud) is the networking container within AWS.
                    All subnets, gateways, and VPC resources go inside this container.
                    NOTE: parent="internet" means this VPC is inside the AWS Cloud container
                -->
                
                <!--
                    VPC Container
                    - shape=mxgraph.aws4.group: Group container shape
                    - grIcon=mxgraph.aws4.group_vpc: VPC icon (green VPC icon)
                    - container=1: Can contain child elements (subnets, etc.)
                    - strokeColor=#248814: Green border (AWS VPC standard color)
                    - fillColor=none: Transparent background
                    - The VPC label shows the CIDR block (e.g., 10.0.0.0/16)
                -->
                <mxCell id="vpc" 
                        value="VPC (10.0.0.0/16)" 
                        style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#248814;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" 
                        parent="internet" 
                        vertex="1">
                    <!--
                        Geometry for VPC:
                        x="400": 400px from left edge of parent (internet container)
                        y="150": 150px from top of parent
                        width="2800": Width of VPC container
                        height="2100": Height of VPC container
                        This leaves space for external services (like S3) outside VPC
                    -->
                    <mxGeometry x="400" y="150" width="2800" height="2100" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    INTERNET GATEWAY
                    ========================================================================
                    Internet Gateway provides internet access to public subnets.
                    It should be placed at the VPC level, not inside a subnet.
                -->
                
                <!--
                    Internet Gateway Icon
                    - shape=mxgraph.aws4.internet_gateway: AWS Internet Gateway icon
                    - fillColor=#8C4FFF: Purple color (networking service category)
                    - aspect=fixed: Maintains icon proportions (important!)
                    - parent="vpc": Placed inside VPC container
                    - verticalLabelPosition=bottom: Label appears below icon
                    - Standard icon size: 78x78 pixels
                -->
                <mxCell id="igw" 
                        value="Internet Gateway" 
                        style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.internet_gateway;" 
                        parent="vpc" 
                        vertex="1">
                    <!--
                        Geometry for Internet Gateway:
                        x="100": 100px from left edge of VPC
                        y="50": 50px from top of VPC
                        width="78": Standard AWS icon width
                        height="78": Standard AWS icon height
                        Position near top-left of VPC
                    -->
                    <mxGeometry x="100" y="50" width="78" height="78" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    PUBLIC SUBNET 1 (Availability Zone 1)
                    ========================================================================
                    Public subnets contain resources that need direct internet access.
                    NAT Gateways, Load Balancers, and Bastion hosts typically go here.
                -->
                
                <!--
                    Public Subnet Container
                    - shape=mxgraph.aws4.group: Group container
                    - grIcon=mxgraph.aws4.group_public_subnet: Public subnet icon
                    - container=1: Can contain child elements
                    - strokeColor=#248814: Green border (matching VPC)
                    - fillColor=#E8F5E9: Light green background (distinguishes public subnet)
                    - Label includes: Subnet name, AZ identifier, CIDR block
                -->
                <mxCell id="public-subnet-1" 
                        value="Public Subnet 1 (AZ-1)&#10;10.0.1.0/24" 
                        style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_public_subnet;strokeColor=#248814;fillColor=#E8F5E9;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" 
                        parent="vpc" 
                        vertex="1">
                    <!--
                        Geometry for Public Subnet 1:
                        x="100": 100px from left edge of VPC
                        y="200": 200px from top (below Internet Gateway)
                        width="1200": Width of subnet (enough for multiple services)
                        height="600": Height of subnet
                        This positioning allows for another subnet beside it
                    -->
                    <mxGeometry x="100" y="200" width="1200" height="600" as="geometry" />
                </mxCell>

                <!--
                    NAT Gateway in Public Subnet 1
                    - shape=mxgraph.aws4.nat_gateway: AWS NAT Gateway icon
                    - fillColor=#8C4FFF: Purple (networking service)
                    - parent="public-subnet-1": Placed inside public subnet
                    - NAT Gateway provides outbound internet for private subnets
                    - Standard icon size: 78x78 pixels
                -->
                <mxCell id="nat-gw-1" 
                        value="NAT Gateway" 
                        style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.nat_gateway;" 
                        parent="public-subnet-1" 
                        vertex="1">
                    <!--
                        Geometry for NAT Gateway:
                        x="50": 50px from left edge of subnet (padding)
                        y="50": 50px from top of subnet (padding)
                        width="78": Standard icon width
                        height="78": Standard icon height
                        Positioned in top-left of subnet with padding
                    -->
                    <mxGeometry x="50" y="50" width="78" height="78" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    PUBLIC SUBNET 2 (Availability Zone 2)
                    ========================================================================
                    Second public subnet for high availability (multi-AZ deployment).
                    Mirrors Public Subnet 1 in a different Availability Zone.
                -->
                
                <!--
                    Public Subnet 2 Container
                    - Same structure as Public Subnet 1
                    - Positioned beside Public Subnet 1 (x="1500")
                    - Different AZ identifier (AZ-2) and CIDR (10.0.2.0/24)
                -->
                <mxCell id="public-subnet-2" 
                        value="Public Subnet 2 (AZ-2)&#10;10.0.2.0/24" 
                        style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_public_subnet;strokeColor=#248814;fillColor=#E8F5E9;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" 
                        parent="vpc" 
                        vertex="1">
                    <!--
                        Geometry for Public Subnet 2:
                        x="1500": Positioned to the right of Public Subnet 1
                        (100 + 1200 + 200 spacing = 1500)
                        y="200": Same vertical position as Public Subnet 1
                        width="1200": Same width as Public Subnet 1
                        height="600": Same height as Public Subnet 1
                    -->
                    <mxGeometry x="1500" y="200" width="1200" height="600" as="geometry" />
                </mxCell>

                <!-- NAT Gateway in Public Subnet 2 -->
                <mxCell id="nat-gw-2" 
                        value="NAT Gateway" 
                        style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.nat_gateway;" 
                        parent="public-subnet-2" 
                        vertex="1">
                    <mxGeometry x="50" y="50" width="78" height="78" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    PRIVATE SUBNET 1 (Availability Zone 1)
                    ========================================================================
                    Private subnets contain resources that don't need direct internet access.
                    Application servers, databases, and internal services go here.
                    Background color is different (light orange) to distinguish from public.
                -->
                
                <!--
                    Private Subnet Container
                    - grIcon=mxgraph.aws4.group_private_subnet: Private subnet icon
                    - fillColor=#FFF4E6: Light orange background (different from public)
                    - Contains compute resources, databases, etc.
                -->
                <mxCell id="private-subnet-1" 
                        value="Private Subnet 1 (AZ-1)&#10;10.0.10.0/24" 
                        style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_private_subnet;strokeColor=#248814;fillColor=#FFF4E6;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" 
                        parent="vpc" 
                        vertex="1">
                    <!--
                        Geometry for Private Subnet 1:
                        x="100": Aligned with Public Subnet 1
                        y="900": Below public subnets (200 + 600 + 100 spacing = 900)
                        width="1200": Same width as public subnet
                        height="1100": Taller to accommodate more services
                    -->
                    <mxGeometry x="100" y="900" width="1200" height="1100" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    EXAMPLE SERVICES IN PRIVATE SUBNET
                    ========================================================================
                    These are example services showing how to place AWS resources.
                    Copy and modify these patterns for your specific services.
                -->
                
                <!--
                    AWS Lambda Function Example
                    - shape=mxgraph.aws4.lambda: AWS Lambda icon (lowercase!)
                    - fillColor=#759C3E: Green (compute service category)
                    - parent="private-subnet-1": Inside private subnet
                    - Standard icon size: 78x78 pixels
                    - Note: Icon shape name is lowercase per m-radzikowski/diagrams-aws-icons
                    - Horizontal spacing: 150px between icons (78 + 72 padding)
                    - Vertical spacing: 150px between rows (78 + 72 padding)
                -->
                <mxCell id="lambda-example" 
                        value="Lambda Function" 
                        style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#759C3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.lambda;" 
                        parent="private-subnet-1" 
                        vertex="1">
                    <!--
                        Geometry for Lambda:
                        x="50": 50px padding from subnet left edge
                        y="100": 100px from subnet top (below subnet label)
                        width="78": Standard AWS icon width
                        height="78": Standard AWS icon height
                    -->
                    <mxGeometry x="50" y="100" width="78" height="78" as="geometry" />
                </mxCell>

                <!--
                    RDS Database Example
                    - shape=mxgraph.aws4.rds: AWS RDS icon (lowercase!)
                    - fillColor=#2E27AD: Blue (database service category)
                    - parent="private-subnet-1": Inside private subnet
                    - Positioned below Lambda functions
                    - Note: Icon shape name is lowercase per m-radzikowski/diagrams-aws-icons
                -->
                <mxCell id="rds-example" 
                        value="RDS PostgreSQL" 
                        style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E27AD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.rds;" 
                        parent="private-subnet-1" 
                        vertex="1">
                    <!--
                        Geometry for RDS:
                        x="50": Aligned with Lambda above
                        y="350": Below Lambda (100 + 78 + 150 spacing = 328, rounded to 350)
                        width="78": Standard icon width
                        height="78": Standard icon height
                    -->
                    <mxGeometry x="50" y="350" width="78" height="78" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    PRIVATE SUBNET 2 (Availability Zone 2)
                    ========================================================================
                    Second private subnet for high availability.
                    Mirrors Private Subnet 1 in a different Availability Zone.
                -->
                
                <!-- Private Subnet 2 Container -->
                <mxCell id="private-subnet-2" 
                        value="Private Subnet 2 (AZ-2)&#10;10.0.11.0/24" 
                        style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_private_subnet;strokeColor=#248814;fillColor=#FFF4E6;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" 
                        parent="vpc" 
                        vertex="1">
                    <!--
                        Geometry for Private Subnet 2:
                        x="1500": Aligned with Public Subnet 2
                        y="900": Same vertical position as Private Subnet 1
                        width="1200": Same width as Private Subnet 1
                        height="1100": Same height as Private Subnet 1
                    -->
                    <mxGeometry x="1500" y="900" width="1200" height="1100" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    VPC ENDPOINTS (Optional)
                    ========================================================================
                    VPC Endpoints allow private access to AWS services without internet.
                    These are typically placed at the VPC level or in private subnets.
                -->
                
                <!-- VPC Endpoint for S3 -->
                <mxCell id="vpc-endpoint-s3" 
                        value="VPC Endpoint&#10;(S3)" 
                        style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.vpc_endpoint;" 
                        parent="vpc" 
                        vertex="1">
                    <!--
                        Geometry for VPC Endpoint:
                        x="2500": Positioned at right side of VPC
                        y="100": Near top of VPC
                        width="78": Standard icon width
                        height="78": Standard icon height
                    -->
                    <mxGeometry x="2500" y="100" width="78" height="78" as="geometry" />
                </mxCell>

                <!--
                    ========================================================================
                    NOTES FOR AI AGENTS
                    ========================================================================
                    
                    SPACING CALCULATIONS:
                    - Standard icon size: 78x78 pixels
                    - Horizontal spacing between icons: 150px (78 icon + 72 padding)
                    - Vertical spacing between rows: 150px (78 icon + 72 padding)
                    - Subnet padding: 50px from edges
                    - Subnet spacing: 200px between subnets
                    
                    GEOMETRY POSITIONING:
                    - x: Horizontal position relative to parent container
                    - y: Vertical position relative to parent container
                    - width: Component width in pixels
                    - height: Component height in pixels
                    - All coordinates are relative to parent, not absolute
                    
                    PARENT-CHILD RELATIONSHIPS:
                    - Internet container → parent="1"
                    - VPC container → parent="internet"
                    - Subnets → parent="vpc"
                    - Services → parent="[subnet-id]"
                    - Always respect this hierarchy for proper nesting
                    
                    ICON SIZE:
                    - Always use 78x78 for AWS service icons
                    - Always include aspect=fixed in style
                    - Never modify icon dimensions - use standard size
                    
                    COLOR CODES:
                    - Compute (Lambda, ECS, EC2): #759C3E (Green)
                    - Storage (S3, EBS, EFS): #759C3E (Green)
                    - Database (RDS, DynamoDB): #2E27AD (Blue)
                    - Networking (VPC, API Gateway): #8C4FFF (Purple)
                    - Security (IAM, Secrets Manager): #8C4FFF (Purple)
                    - AI/ML (Bedrock, SageMaker): #4D27AA (Dark Purple)
                    
                    STYLE ATTRIBUTES:
                    - aspect=fixed: Maintains icon proportions (REQUIRED)
                    - fillColor: Service category color (see above)
                    - strokeColor: Border color (usually none for icons)
                    - fontColor: Text color (#232F3E = dark gray)
                    - verticalLabelPosition=bottom: Label below icon
                    - html=1: Enable HTML in labels (allows line breaks with &#10;)
                    
                    MODIFYING THIS TEMPLATE:
                    1. Copy the structure for the component you need
                    2. Change the id to something unique
                    3. Update the value (label text)
                    4. Adjust geometry x/y for positioning
                    5. Keep all style attributes identical
                    6. Ensure parent is set correctly
                    7. Verify icon shape name matches service (see ICON_REFERENCE.md)
                -->
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>

