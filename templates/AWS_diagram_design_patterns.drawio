  <diagram id="LogicalPathsExample" name="Logical Paths">
    <mxGraphModel dx="757" dy="543" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" background="#ffffff" math="0" shadow="0">
      <root>
